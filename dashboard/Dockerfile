FROM node:20-slim

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ARG NEXT_PUBLIC_OPTIMIZER_URL
ARG NEXT_PUBLIC_CLOUD_RUN_URL

ENV NEXT_PUBLIC_OPTIMIZER_URL=$NEXT_PUBLIC_OPTIMIZER_URL
ENV NEXT_PUBLIC_CLOUD_RUN_URL=$NEXT_PUBLIC_CLOUD_RUN_URL

RUN npm run build

ENV NODE_ENV=production

EXPOSE 8080

CMD ["npm", "start"]

